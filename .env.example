# BulutSkan sozlamalari namunasi.
# Ishlatish: bu faylni .env nomi bilan nusxalang va qiymatlarni o'zgartiring.
# run.ps1 birinchi ishga tushishda .env faylini o'zi yaratadi va
# BULUTSKAN_SECRET_KEY uchun tasodifiy qiymat hosil qiladi.
# .env fayli hech qachon commit qilinmaydi (.gitignore ga kiritilgan).

# Sessiya cookie'larini imzolash kaliti. Bu yerda faqat namuna turibdi.
BULUTSKAN_SECRET_KEY=almashtiring-bu-faqat-namuna

# Tarmoq: sukut bo'yicha faqat mahalliy manzil.
BULUTSKAN_HOST=127.0.0.1
BULUTSKAN_PORT=8000

# Interfeys tili: uz yoki en
BULUTSKAN_LANG=uz

# Ish ma'lumotlari katalogi (SQLite bazasi, vaqtinchalik kataloglar,
# zaifliklar bazalari, hisobotlar). Nisbiy yo'l loyiha ildiziga nisbatan.
BULUTSKAN_DATA_DIR=./data

# Fayl yuklash limitlari
BULUTSKAN_MAX_UPLOAD_MB=20
BULUTSKAN_MAX_UNZIPPED_MB=100
BULUTSKAN_MAX_ZIP_ENTRIES=1000
BULUTSKAN_MAX_FILE_MB=10
BULUTSKAN_MAX_IMAGE_TAR_MB=4096

# Skaner konteynerlari limitlari
BULUTSKAN_CONTAINER_CPUS=2
BULUTSKAN_CONTAINER_MEMORY=2g
BULUTSKAN_CONTAINER_PIDS=512
BULUTSKAN_CONTAINER_TMPFS=512m
BULUTSKAN_SCAN_TIMEOUT_S=900
BULUTSKAN_PULL_TIMEOUT_S=1800
BULUTSKAN_DB_UPDATE_TIMEOUT_S=1800

# Grype bazasi eskirganini tekshirish (sukut: true). Eksperimentni eski baza
# bilan aynan takrorlash uchun vaqtincha false qilish mumkin.
BULUTSKAN_GRYPE_VALIDATE_AGE=true

# Trivy bazasini ulash usuli: readonly (sukut) yoki copy. Trivy bazani faqat
# o'qish rejimida ocha olmasa, platforma o'zi nusxa bilan qayta urinadi.
BULUTSKAN_TRIVY_DB_MODE=readonly

# Docker buyrug'i (PATH da bo'lsa o'zgartirish shart emas)
BULUTSKAN_DOCKER_BIN=docker

# Eslatma: proksi manzili bu yerda saqlanmaydi. U faqat bazalarni
# yangilash paytida `docker info --format "{{.HTTPSProxy}}"` orqali
# o'qiladi va hech qayerga yozilmaydi.
